      "terminalOptions": {
        "allowProposedApi": true,
        "allowTransparency": true,
        "altClickMovesCursor": false,
        "convertEol": true,
        "cursorBlink": true,
        "cursorInactiveStyle": "underline",
        "cursorStyle": "bar",
        "cursorWidth": 2,
        "customGlyphs": false,
        "disableStdin": false,
        "documentOverride": null,
